{
  "name": "spectrum-ssr-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Server-side rendering support for Adobe Spectrum Web Components (1st-gen) built on @lit-labs/ssr, plus a demo page and hydration tests",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build:client": "node demo/build.mjs",
    "demo": "npm run build:client && tsx demo/src/server.ts",
    "demo:dev": "tsx demo/src/server.ts",
    "test:unit": "tsx --test packages/spectrum-web-components-ssr/test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:pkg": "tsc -p packages/spectrum-web-components-ssr/tsconfig.build.json",
    "clean:pkg": "node -e \"require('node:fs').rmSync('packages/spectrum-web-components-ssr/dist',{recursive:true,force:true})\"",
    "pkg:prepare": "node scripts/prepare-publish.mjs",
    "pkg:restore": "node scripts/prepare-publish.mjs --restore",
    "pkg:verify": "node scripts/verify-package.mjs",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit-labs/ssr-dom-shim": "1.6.0",
    "@spectrum-web-components/bundle": "1.12.4",
    "@types/compression": "^1.8.1",
    "@webcomponents/template-shadowroot": "0.2.1",
    "compression": "^1.8.2",
    "css-select": "^5.1.0",
    "express": "^4.21.2",
    "lit": "3.3.3",
    "parse5": "^7.2.1",
    "parse5-htmlparser2-tree-adapter": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.24.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
